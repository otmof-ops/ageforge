#!/bin/sh
# Build the Rust core (core/), the world the game runs on, and install it into the package. Needs Rust 1.80+ (rustup).
set -e
here="$(cd "$(dirname "$0")/.." && pwd)"
cd "$here/core"
python3 gen_tables.py
cargo build --release
cp target/release/lib_core.so "$here/realm_of_ages/_core.abi3.so"
echo "Rust core installed: realm_of_ages/_core.abi3.so"
